    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Embedding Generation Failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(legal_ai_embedding_requests_total{status=\"failed\"}[5m]))",
          "legendFormat": "Failures / 5m"
