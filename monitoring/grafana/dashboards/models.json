              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Critical False Negatives (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(legal_ai_model_false_negatives_total{model_name=\"risk_classifier\",class=\"critical\"}[1h]))",
          "legendFormat": "Critical misses"
