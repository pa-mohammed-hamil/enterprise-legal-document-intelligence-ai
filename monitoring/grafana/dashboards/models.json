      "title": "High-Risk Recall",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "legal_ai_model_evaluation_class_recall{model_name=\"risk_classifier\",class=\"high\"}",
