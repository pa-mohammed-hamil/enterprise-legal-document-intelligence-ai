        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "legal_ai_model_evaluation_precision{model_name=\"legal_ner\"}",
          "legendFormat": "Precision"
        },
        {
          "refId": "B",
          "expr": "legal_ai_model_evaluation_recall{model_name=\"legal_ner\"}",
          "legendFormat": "Recall"
        },
        {
          "refId": "C",
          "expr": "legal_ai_model_evaluation_f1{model_name=\"legal_ner\"}",
          "legendFormat": "F1"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
